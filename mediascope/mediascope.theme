<?php

/**
 * @file
 * MediaScope theme file.
 * 
 * Custom theme functions for the MediaScope online media site theme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\node\Entity\Node;

/**
 * Implements hook_preprocess_html().
 */
function mediascope_preprocess_html(&$variables) {
  // Add theme-specific classes to body
  $variables['attributes']['class'][] = 'mediascope-theme';
  
  // Add reading progress bar for article pages
  if (!empty($variables['page']['#node'])) {
    $node = $variables['page']['#node'];
    if ($node->getType() == 'article') {
      $variables['attributes']['class'][] = 'has-reading-progress';
      $variables['#attached']['library'][] = 'mediascope/article-enhancements';
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function mediascope_preprocess_page(&$variables) {
  // Add current page type class
  if (!empty($variables['node'])) {
    $variables['attributes']['class'][] = 'page-type-' . $variables['node']->getType();
  }
  
  // Attach media components library for media-rich pages
  $media_content_types = ['article', 'media', 'gallery'];
  if (!empty($variables['node']) && in_array($variables['node']->getType(), $media_content_types)) {
    $variables['#attached']['library'][] = 'mediascope/media-components';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function mediascope_preprocess_node(&$variables) {
  $node = $variables['node'];
  
  // Add article-specific preprocessing
  if ($node->getType() == 'article') {
    // Add reading time estimation
    $content = $node->get('body')->value;
    $word_count = str_word_count(strip_tags($content));
    $reading_time = ceil($word_count / 200); // Average reading speed
    $variables['reading_time'] = $reading_time;
    
    // Add article metadata
    $variables['article_date'] = $node->getCreatedTime();
    $variables['article_author'] = $node->getOwner()->getDisplayName();
    
    // Add social sharing data
    $variables['share_url'] = $node->toUrl('canonical', ['absolute' => TRUE])->toString();
    $variables['share_title'] = $node->getTitle();
  }
  
  // Add media gallery support
  if ($node->hasField('field_media_gallery') && !$node->get('field_media_gallery')->isEmpty()) {
    $variables['has_gallery'] = TRUE;
    $variables['#attached']['library'][] = 'mediascope/media-components';
  }
}

/**
 * Implements hook_preprocess_field().
 */
function mediascope_preprocess_field(&$variables) {
  $field_name = $variables['field_name'];
  
  // Enhanced image field preprocessing
  if ($field_name == 'field_image' || $field_name == 'field_media_image') {
    $variables['attributes']['class'][] = 'media-image-field';
    
    // Add lazy loading support
    foreach ($variables['items'] as &$item) {
      $item['attributes']['data-lazy'] = 'true';
    }
  }
  
  // Video field preprocessing
  if ($field_name == 'field_video' || $field_name == 'field_media_video') {
    $variables['attributes']['class'][] = 'media-video-field';
    $variables['#attached']['library'][] = 'mediascope/media-components';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function mediascope_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Add template suggestions for different content types
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    if ($node instanceof Node) {
      $suggestions[] = 'page__node__' . $node->getType();
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function mediascope_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  
  // Add view mode suggestions
  if ($variables['elements']['#view_mode'] == 'teaser') {
    $suggestions[] = 'node__' . $node->getType() . '__teaser';
  }
  
  // Add card layout suggestions for media content
  if (in_array($node->getType(), ['article', 'media'])) {
    $suggestions[] = 'node__' . $node->getType() . '__card';
  }
}

/**
 * Implements hook_form_alter().
 */
function mediascope_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Enhance search form for media site
  if ($form_id == 'search_block_form') {
    $form['keys']['#attributes']['placeholder'] = t('Search articles, videos, and media...');
    $form['keys']['#attributes']['class'][] = 'media-search-input';
  }
}

/**
 * Custom function to format article metadata.
 */
function mediascope_format_article_meta($node) {
  $meta = [];
  
  if ($node->getType() == 'article') {
    $meta['date'] = \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'medium');
    $meta['author'] = $node->getOwner()->getDisplayName();
    
    // Add category if available
    if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
      $category = $node->get('field_category')->entity;
      $meta['category'] = $category->getName();
    }
    
    // Add tags if available
    if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
      $tags = [];
      foreach ($node->get('field_tags') as $tag) {
        $tags[] = $tag->entity->getName();
      }
      $meta['tags'] = $tags;
    }
  }
  
  return $meta;
}
